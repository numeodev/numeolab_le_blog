---
import ProjectIndex from '../layouts/ProjectIndex.astro';
import { SITE_TITLE } from '../consts';
import { PROJECTS_PER_PAGE } from '../directus/api';
import { getProjectEntries } from '../lib/entries';

const projects = await getProjectEntries();
---

<ProjectIndex
	pageTitle={`Projets — ${SITE_TITLE}`}
	total={projects.length}
	projects={projects.slice(0, PROJECTS_PER_PAGE)}
	currentPage={1}
	totalPages={Math.ceil(projects.length / PROJECTS_PER_PAGE)}
/>
