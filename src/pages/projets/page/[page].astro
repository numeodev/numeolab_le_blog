---
import type { GetStaticPaths } from 'astro';
import ProjectIndex from '../../../layouts/ProjectIndex.astro';
import { SITE_TITLE } from '../../../consts';
import { PROJECTS_PER_PAGE } from '../../../directus/api';
import { getProjectEntries, type ProjectEntry } from '../../../lib/entries';

export const getStaticPaths = (async () => {
	const allProjects = await getProjectEntries();
	const totalPages = Math.ceil(allProjects.length / PROJECTS_PER_PAGE);
	const paths = [];

	for (let i = 2; i <= totalPages; i++) {
		const start = (i - 1) * PROJECTS_PER_PAGE;
		paths.push({
			params: { page: i.toString() },
			props: {
				projects: allProjects.slice(start, start + PROJECTS_PER_PAGE),
				total: allProjects.length,
				currentPage: i,
				totalPages,
			},
		});
	}

	return paths;
}) satisfies GetStaticPaths;

interface Props {
	projects: ProjectEntry[];
	total: number;
	currentPage: number;
	totalPages: number;
}

const { projects, total, currentPage, totalPages } = Astro.props;
---

<ProjectIndex
	pageTitle={`Projets, page ${currentPage} — ${SITE_TITLE}`}
	total={total}
	projects={projects}
	currentPage={currentPage}
	totalPages={totalPages}
/>
