---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={`Page introuvable — ${SITE_TITLE}`} description="Cette page n'existe pas." />
		<meta name="robots" content="noindex" />
	</head>
	<body>
		<Header />
		<main>
			<PageHeader
				kicker="Erreur 404"
				title="Page introuvable"
				intro="Cette adresse ne correspond à aucune page : elle a peut-être été déplacée ou supprimée."
			/>
			<section class="py-[72px] pb-28">
				<div class="wrap">
					<p class="meta m-0 mb-10">GET <span id="path" class="text-text">/</span> → <span class="text-signal">404 Not Found</span></p>
					<div class="flex flex-wrap gap-3">
						<a href="/blog/" class="btn btn--primary">Lire les articles<Icon name="arrow-right" size={16} /></a>
						<a href="/" class="btn btn--ghost">Retour à l'accueil</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	document.addEventListener('astro:page-load', () => {
		const pathEl = document.getElementById('path');
		if (pathEl) pathEl.textContent = window.location.pathname;
	});
</script>
