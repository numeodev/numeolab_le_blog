---
import type { GetStaticPaths } from 'astro';
import ArticleIndex from '../../../layouts/ArticleIndex.astro';
import { SITE_TITLE } from '../../../consts';
import { POSTS_PER_PAGE } from '../../../directus/api';
import { getArticleEntries, getThemes, type ArticleEntry, type Theme } from '../../../lib/entries';

export const getStaticPaths = (async () => {
	const allArticles = await getArticleEntries();
	const themes = getThemes(allArticles);
	const totalPages = Math.ceil(allArticles.length / POSTS_PER_PAGE);
	const paths = [];

	for (let i = 2; i <= totalPages; i++) {
		const start = (i - 1) * POSTS_PER_PAGE;
		paths.push({
			params: { page: i.toString() },
			props: {
				articles: allArticles.slice(start, start + POSTS_PER_PAGE),
				total: allArticles.length,
				themes,
				currentPage: i,
				totalPages,
			},
		});
	}

	return paths;
}) satisfies GetStaticPaths;

interface Props {
	articles: ArticleEntry[];
	total: number;
	themes: Theme[];
	currentPage: number;
	totalPages: number;
}

const { articles, total, themes, currentPage, totalPages } = Astro.props;
---

<ArticleIndex
	pageTitle={`Articles, page ${currentPage} — ${SITE_TITLE}`}
	description="Analyses, retours d'expérience et notes de lecture sur la conception, l'exploitation et la gouvernance des systèmes logiciels."
	kicker={`Articles · ${total} entrées · page ${currentPage}/${totalPages}`}
	heading="Toutes les publications"
	intro="Analyses, retours d'expérience et notes de lecture sur la conception, l'exploitation et la gouvernance des systèmes logiciels."
	articles={articles}
	themes={themes}
	pagination={{ currentPage, totalPages }}
/>
