---
import type { Heading } from '../lib/entries';

interface Props {
	headings: Heading[];
}

const { headings } = Astro.props;
---

<nav class="toc" aria-label="Sommaire">
	<p class="m-0 mb-3.5 text-[13px] font-semibold">Sommaire</p>
	<ol class="toc__list">
		{headings.map((heading) => (
			<li>
				<a href={`#${heading.id}`} class:list={['toc__link', { 'toc__link--sub': heading.level === 3 }]}>
					<span class="toc__mark" aria-hidden="true"></span>{heading.text}
				</a>
			</li>
		))}
	</ol>
</nav>

<style>
	.toc {
		grid-column: 3;
		position: sticky;
		top: 72px;
		align-self: start;
		max-width: 260px;
		max-height: calc(100vh - 72px);
		overflow-y: auto;
		padding: 80px 32px 24px 40px;
		box-sizing: content-box;
	}

	.toc__list {
		display: flex;
		flex-direction: column;
		gap: 2px;
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: 14px;
		line-height: 1.45;
	}

	.toc__link {
		display: flex;
		gap: 10px;
		align-items: baseline;
		padding: 7px 0;
		color: var(--color-muted);
	}

	.toc__link--sub {
		padding-left: 16px;
	}

	.toc__link:hover {
		color: #fff;
	}

	.toc__mark {
		flex: none;
		width: 6px;
		height: 6px;
		border-radius: 1px;
		transform: translateY(-2px);
	}

	.toc__link[aria-current='true'] {
		color: var(--color-paper);
		font-weight: 500;
	}

	.toc__link[aria-current='true'] .toc__mark {
		background: var(--color-signal);
	}

	@media (max-width: 1100px) {
		.toc {
			display: none;
		}
	}
</style>

<script>
	// Marque l'intertitre en cours de lecture : le dernier dont le haut est
	// passé sous la barre de navigation.
	function initToc() {
		const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc__link')];
		if (links.length === 0) return;

		const targets = links
			.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
			.filter((el): el is HTMLElement => el !== null);

		let frame = 0;
		const update = () => {
			frame = 0;
			const offset = 120;
			let active = 0;
			targets.forEach((target, i) => {
				if (target.getBoundingClientRect().top <= offset) active = i;
			});
			links.forEach((link, i) => {
				if (i === active) link.setAttribute('aria-current', 'true');
				else link.removeAttribute('aria-current');
			});
		};
		const onScroll = () => {
			if (!frame) frame = requestAnimationFrame(update);
		};

		update();
		window.addEventListener('scroll', onScroll, { passive: true });
		document.addEventListener('astro:before-swap', () => window.removeEventListener('scroll', onScroll), { once: true });
	}

	document.addEventListener('astro:page-load', initToc);
</script>
