---
import Icon from './Icon.astro';

const today = new Date();
---

<footer class="site-footer">
	<div class="wrap site-footer__inner">
		<p class="m-0 text-sm text-muted">&copy; {today.getFullYear()} Numeolab</p>
		<nav aria-label="Liens de pied de page" class="flex flex-wrap gap-7 text-sm">
			<a href="/mentions-legales/" class="text-muted hover:text-white">Mentions légales</a>
			<a href="/politique-de-confidentialite/" class="text-muted hover:text-white">Politique de confidentialité</a>
		</nav>
		<div class="flex gap-2">
			<a href="https://github.com/numeodev" class="icon-link" aria-label="Profil GitHub" target="_blank" rel="noopener noreferrer">
				<Icon name="github" />
			</a>
			<a href="https://ko-fi.com/numeolab" class="icon-link" aria-label="Soutenir sur Ko-fi" target="_blank" rel="noopener noreferrer">
				<Icon name="kofi" />
			</a>
			<a href="/rss.xml" class="icon-link" aria-label="Flux RSS">
				<Icon name="rss" />
			</a>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-line-strong);
		padding: 40px 0 48px;
	}

	.site-footer__inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
		flex-wrap: wrap;
	}
</style>
