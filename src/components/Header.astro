---
import HeaderLink from './HeaderLink.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const links = [
	{ href: '/', label: 'Accueil' },
	{ href: '/blog/', label: 'Articles' },
	{ href: '/projets/', label: 'Projets' },
	{ href: '/a-propos/', label: 'À propos' },
];
---

<header class="site-header">
	<div class="wrap site-header__bar">
		<a href="/" aria-label="Numeolab, accueil" class="flex items-center" transition:persist transition:name="site-logo">
			<Logo />
		</a>
		<nav class="site-nav" aria-label="Navigation principale">
			{links.map(({ href, label }) => <HeaderLink href={href} data-astro-prefetch>{label}</HeaderLink>)}
			<a href="/rss.xml" class="site-nav__rss" aria-label="Flux RSS"><Icon name="rss" size={18} /></a>
		</nav>
		<button
			id="menu-toggle"
			type="button"
			class="menu-toggle"
			aria-label="Ouvrir le menu"
			aria-expanded="false"
			aria-controls="mobile-nav"
		>
			<Icon name="menu" class="menu-toggle__open" />
			<Icon name="close" class="menu-toggle__close" />
		</button>
	</div>

	<div id="mobile-nav-backdrop" class="mobile-backdrop" hidden></div>

	<nav id="mobile-nav" class="mobile-nav" aria-label="Navigation mobile" hidden>
		<div class="wrap">
			{links.map(({ href, label }) => <HeaderLink href={href} data-astro-prefetch>{label}</HeaderLink>)}
			<a href="/rss.xml">Flux RSS</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		border-bottom: 1px solid var(--color-line-strong);
		background: var(--color-ink);
		box-shadow: 0 1px 0 rgba(0, 0, 0, 0.35), 0 8px 24px rgba(2, 6, 23, 0.35);
	}

	.site-header__bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
		height: 72px;
	}

	.site-nav {
		display: flex;
		gap: 36px;
		align-items: center;
		font-size: 15px;
	}

	.site-nav :global(a) {
		color: var(--color-body);
	}

	.site-nav :global(a:hover) {
		color: #fff;
	}

	.site-nav :global(a.active) {
		color: var(--color-text);
		font-weight: 500;
		padding: 25px 0 23px;
		border-bottom: 2px solid var(--color-signal);
	}

	.site-nav .site-nav__rss {
		display: flex;
		color: var(--color-muted);
		padding: 12px 0;
	}

	.menu-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		padding: 0;
		background: transparent;
		border: 1px solid var(--color-line-strong);
		border-radius: 6px;
		color: var(--color-text);
		cursor: pointer;
	}

	.menu-toggle :global(.menu-toggle__close),
	.menu-toggle[aria-expanded='true'] :global(.menu-toggle__open) {
		display: none;
	}

	.menu-toggle[aria-expanded='true'] :global(.menu-toggle__close) {
		display: block;
	}

	.mobile-backdrop {
		position: fixed;
		inset: 72px 0 0;
		z-index: 40;
		background: rgb(0 0 0 / 0.6);
	}

	.mobile-nav {
		position: relative;
		z-index: 50;
		border-top: 1px solid var(--color-line);
		background: var(--color-ink);
	}

	.mobile-nav :global(a) {
		display: flex;
		align-items: center;
		min-height: 52px;
		border-bottom: 1px solid var(--color-line);
		color: var(--color-body);
		font-size: 16px;
	}

	.mobile-nav :global(a:last-child) {
		border-bottom: 0;
	}

	.mobile-nav :global(a.active) {
		color: var(--color-text);
		font-weight: 500;
		box-shadow: inset 2px 0 0 var(--color-signal);
		padding-left: 14px;
	}

	@media (max-width: 860px) {
		.site-nav {
			display: none;
		}

		.menu-toggle {
			display: inline-flex;
		}
	}

	@media (min-width: 861px) {
		.mobile-nav,
		.mobile-backdrop {
			display: none;
		}
	}
</style>

<script>
	function getNavEls() {
		return {
			toggle: document.getElementById('menu-toggle'),
			mobileNav: document.getElementById('mobile-nav'),
			backdrop: document.getElementById('mobile-nav-backdrop'),
		};
	}

	function setMenuOpen(open: boolean) {
		const { toggle, mobileNav, backdrop } = getNavEls();
		toggle?.setAttribute('aria-expanded', String(open));
		toggle?.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
		if (mobileNav) mobileNav.hidden = !open;
		if (backdrop) backdrop.hidden = !open;
		document.body.classList.toggle('overflow-hidden', open);
	}

	function initMobileNav() {
		const { toggle, mobileNav, backdrop } = getNavEls();

		toggle?.addEventListener('click', () => {
			setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
		});

		backdrop?.addEventListener('click', () => setMenuOpen(false));

		mobileNav?.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setMenuOpen(false));
		});
	}

	// Réexécuté au chargement initial et après chaque navigation ClientRouter,
	// car le header (hors logo persisté) est reconstruit à chaque page.
	document.addEventListener('astro:page-load', initMobileNav);

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') setMenuOpen(false);
	});
</script>
