---
import { getArticleEntries } from '../lib/entries';
import EntryRow from './EntryRow.astro';

const RECENT_COUNT = 4;
const articles = (await getArticleEntries()).slice(0, RECENT_COUNT);
---

<section aria-labelledby="sec-articles" class="home-sec bg-surface">
	<div class="wrap split">
		<div class="split__intro">
			<p class="kicker mb-4">Articles</p>
			<h2 id="sec-articles" class="section-title mb-4">Publications récentes</h2>
			<p class="m-0 mb-7 text-base leading-relaxed text-muted">
				Analyses, retours d'expérience et notes de lecture sur la conception, l'exploitation et la gouvernance des
				systèmes logiciels.
			</p>
			<a href="/blog/" class="inline-flex items-center min-h-11 text-[15px] font-medium" data-astro-prefetch>Tous les articles →</a>
		</div>
		<div>
			{articles.length === 0 ? (
				<p class="m-0 py-8 border-t border-line-strong text-muted">Les premiers articles arrivent — revenez bientôt.</p>
			) : (
				<ul class="list-none m-0 p-0 border-t border-line-strong">
					{articles.map((article) => <EntryRow article={article} />)}
				</ul>
			)}
		</div>
	</div>
</section>

<style>
	.home-sec {
		padding: 104px 0;
		border-bottom: 1px solid var(--color-line-strong);
	}

	@media (max-width: 860px) {
		.home-sec {
			padding: 72px 0;
		}
	}
</style>
