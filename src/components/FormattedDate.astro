---
// Format court dans les listes (« 3 nov. 2026 »), long sur les pages de
// détail (« 3 novembre 2026 »).
interface Props {
	date: Date;
	format?: 'short' | 'long' | 'day-month' | 'month-year';
	class?: string;
}

const { date, format = 'short', class: className } = Astro.props;

const options: Record<NonNullable<Props['format']>, Intl.DateTimeFormatOptions> = {
	short: { day: 'numeric', month: 'short', year: 'numeric' },
	long: { day: 'numeric', month: 'long', year: 'numeric' },
	'day-month': { day: 'numeric', month: 'short' },
	'month-year': { month: 'short', year: 'numeric' },
};
---

<time class={className} datetime={date.toISOString()}>{date.toLocaleDateString('fr-FR', options[format])}</time>
