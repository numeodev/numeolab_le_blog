---
import Icon from './Icon.astro';

// Agrandit les images du corps de l'article au clic, dans un <dialog> natif.
// L'image s'ouvre ajustée à l'écran ; un clic dessus la zoome (au moins deux
// fois sa taille ajustée) et la vue défile pour s'y déplacer. Échap, le bouton
// ou un clic hors de l'image referment la vue.
---

<dialog id="lightbox" class="lightbox" aria-label="Image agrandie">
	<div class="lightbox__scroller">
		<figure class="lightbox__figure">
			<img class="lightbox__img" src="" alt="" />
			<figcaption class="lightbox__caption"></figcaption>
		</figure>
	</div>
	<button type="button" class="lightbox__close" aria-label="Fermer l'image">
		<Icon name="close" size={22} />
	</button>
</dialog>

<style>
	.lightbox {
		width: 100vw;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--color-text);
		overflow: hidden;
	}

	.lightbox::backdrop {
		background: rgb(11 18 32 / 0.94);
	}

	.lightbox__scroller {
		width: 100%;
		height: 100%;
		overflow: auto;
		overscroll-behavior: contain;
		display: flex;
	}

	.lightbox__figure {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 12px;
		margin: auto;
		padding: 64px 24px 24px;
		box-sizing: border-box;
		min-width: 100%;
		min-height: 100%;
	}

	.lightbox__img {
		display: block;
		max-width: min(1400px, 100%);
		max-height: calc(100dvh - 140px);
		object-fit: contain;
		border-radius: 8px;
		cursor: zoom-in;
	}

	.lightbox--zoomed .lightbox__figure {
		align-items: flex-start;
		justify-content: flex-start;
		min-width: max-content;
	}

	.lightbox--zoomed .lightbox__img {
		max-width: none;
		max-height: none;
		cursor: zoom-out;
	}

	.lightbox--zoomed .lightbox__caption {
		display: none;
	}

	.lightbox__caption {
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--color-muted);
		text-align: center;
	}

	.lightbox__caption:empty {
		display: none;
	}

	.lightbox__close {
		position: fixed;
		top: 16px;
		right: 16px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 1px solid var(--color-line-strong);
		border-radius: 6px;
		background: var(--color-ink);
		color: var(--color-text);
		cursor: pointer;
	}

	.lightbox__close:hover {
		border-color: var(--color-signal);
		color: #fff;
	}

	@media (max-width: 860px) {
		.lightbox__figure {
			padding: 72px 8px 16px;
		}
	}

	:global(.zoomable) {
		cursor: zoom-in;
	}
</style>

<script>
	const ZOOM_FACTOR = 2.5;

	function initLightbox() {
		const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
		if (!dialog) return;
		const scroller = dialog.querySelector<HTMLElement>('.lightbox__scroller')!;
		const full = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
		const caption = dialog.querySelector<HTMLElement>('.lightbox__caption')!;
		const closeButton = dialog.querySelector<HTMLButtonElement>('.lightbox__close')!;

		const unzoom = () => {
			dialog.classList.remove('lightbox--zoomed');
			full.style.width = '';
		};

		// Zoome en gardant sous le doigt (ou le curseur) le point touché.
		const zoomAt = (clientX: number, clientY: number) => {
			const rect = full.getBoundingClientRect();
			const ratioX = (clientX - rect.left) / rect.width;
			const ratioY = (clientY - rect.top) / rect.height;
			const width = Math.max(full.naturalWidth || 0, rect.width * ZOOM_FACTOR);

			dialog.classList.add('lightbox--zoomed');
			full.style.width = `${Math.round(width)}px`;

			const zoomed = full.getBoundingClientRect();
			scroller.scrollLeft += zoomed.left + zoomed.width * ratioX - clientX;
			scroller.scrollTop += zoomed.top + zoomed.height * ratioY - clientY;
		};

		const open = (img: HTMLImageElement) => {
			unzoom();
			full.src = img.currentSrc || img.src;
			full.alt = img.alt;
			caption.textContent = img.closest('figure')?.querySelector('figcaption')?.textContent?.trim() || img.alt;
			dialog.showModal();
			scroller.scrollTo(0, 0);
		};

		// Les images déjà cliquables (dans un lien) gardent leur comportement.
		document.querySelectorAll<HTMLImageElement>('.post-content img').forEach((img) => {
			if (img.closest('a')) return;
			img.classList.add('zoomable');
			img.tabIndex = 0;
			img.setAttribute('role', 'button');
			img.setAttribute('aria-label', img.alt ? `Agrandir l'image : ${img.alt}` : "Agrandir l'image");
			img.addEventListener('click', () => open(img));
			img.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					open(img);
				}
			});
		});

		full.addEventListener('click', (e) => {
			e.stopPropagation();
			if (dialog.classList.contains('lightbox--zoomed')) unzoom();
			else zoomAt(e.clientX, e.clientY);
		});

		closeButton.addEventListener('click', () => dialog.close());

		// Un clic hors de l'image referme la vue.
		scroller.addEventListener('click', () => dialog.close());
		dialog.addEventListener('close', unzoom);
	}

	document.addEventListener('astro:page-load', initLightbox);
</script>
