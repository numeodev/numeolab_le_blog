---
import Icon from './Icon.astro';

export interface Props {
	currentPage: number;
	totalPages: number;
	baseUrl: string;
}

const { currentPage, totalPages, baseUrl } = Astro.props;

const pageUrl = (page: number) => (page === 1 ? `${baseUrl}/` : `${baseUrl}/page/${page}/`);

const generatePageNumbers = (current: number, total: number): (number | '…')[] => {
	if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
	if (current <= 4) return [1, 2, 3, 4, 5, '…', total];
	if (current >= total - 3) return [1, '…', total - 4, total - 3, total - 2, total - 1, total];
	return [1, '…', current - 1, current, current + 1, '…', total];
};

const pageNumbers = generatePageNumbers(currentPage, totalPages);
---

<nav aria-label="Pagination" class="pagination">
	{currentPage > 1 ? (
		<a href={pageUrl(currentPage - 1)} class="pg-step" rel="prev">
			<Icon name="arrow-left" size={16} /><span class="pg-label">Précédent</span>
		</a>
	) : (
		<span class="pg-step pg-step--disabled" aria-disabled="true">
			<Icon name="arrow-left" size={16} /><span class="pg-label">Précédent</span>
		</span>
	)}

	<div class="flex items-center gap-1.5">
		{pageNumbers.map((page) =>
			page === '…' ? (
				<span class="pg-num text-faint" aria-hidden="true">…</span>
			) : (
				<a
					href={pageUrl(page)}
					class="pg-num"
					aria-current={page === currentPage ? 'page' : undefined}
					aria-label={`Page ${page}`}
				>
					{page}
				</a>
			)
		)}
	</div>

	{currentPage < totalPages ? (
		<a href={pageUrl(currentPage + 1)} class="pg-step" rel="next">
			<span class="pg-label">Suivant</span><Icon name="arrow-right" size={16} />
		</a>
	) : (
		<span class="pg-step pg-step--disabled" aria-disabled="true">
			<span class="pg-label">Suivant</span><Icon name="arrow-right" size={16} />
		</span>
	)}
</nav>

<style>
	.pagination {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		margin-top: 64px;
		padding-top: 32px;
		border-top: 1px solid var(--color-line-strong);
	}

	.pg-step {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		padding: 0 16px;
		border: 1px solid var(--color-line-strong);
		border-radius: 6px;
		color: var(--color-text);
		font-size: 14px;
		font-weight: 500;
	}

	a.pg-step:hover {
		border-color: var(--color-line-hover);
		color: #fff;
	}

	.pg-step--disabled {
		border-color: var(--color-line);
		color: var(--color-faint);
		font-weight: 400;
	}

	.pg-num {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 6px;
		border: 1px solid transparent;
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 14px;
	}

	a.pg-num:hover {
		border-color: var(--color-line-hover);
		color: #fff;
	}

	.pg-num[aria-current='page'] {
		background: var(--color-surface-2);
		border-color: var(--color-signal);
		color: #fff;
	}

	@media (max-width: 860px) {
		.pg-label {
			display: none;
		}
	}
</style>
