---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const normalize = (p: string) => (p.length > 1 ? p.replace(/\/$/, '') : p);
const pathname = normalize(Astro.url.pathname);
const hrefNorm = normalize(String(href ?? ''));
const section = '/' + (pathname.match(/[^/]+/)?.[0] ?? '');
const isActive = hrefNorm === pathname || (hrefNorm !== '/' && hrefNorm === section);
---

<a href={href} class:list={[className, { active: isActive }]} aria-current={isActive ? 'page' : undefined} {...props}>
	<slot />
</a>
