---
// Le « o » de « numeolab » est un cadran d'instrument : anneau en Blanc papier,
// aiguille en Indigo signal. Composé en IBM Plex Sans semi-gras, en minuscules.
interface Props {
	size?: number;
	class?: string;
}

const { size = 23, class: className } = Astro.props;
---

<span class:list={['logo', className]} style={`font-size: ${size}px`}>nume<svg
		width="0.6em"
		height="0.6em"
		viewBox="0 0 36 36"
		aria-hidden="true"
		><circle cx="18" cy="18" r="13.5" fill="none" stroke="#F8FAFC" stroke-width="5.4" stroke-dasharray="76 8.8" transform="rotate(-26 18 18)"></circle><line x1="18" y1="18" x2="27.5" y2="8.5" stroke="#818CF8" stroke-width="3.4" stroke-linecap="round"></line><circle cx="18" cy="18" r="2.6" fill="#818CF8"></circle></svg>lab</span>

<style>
	.logo {
		font-family: var(--font-sans);
		font-weight: 600;
		letter-spacing: -0.02em;
		white-space: nowrap;
		color: var(--color-paper);
		line-height: 1;
	}

	svg {
		display: inline;
		vertical-align: -0.035em;
		margin: 0 0.015em;
	}
</style>
