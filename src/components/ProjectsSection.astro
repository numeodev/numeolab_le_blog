---
import { getProjectEntries } from '../lib/entries';
import ProjectCard from './ProjectCard.astro';

const RECENT_COUNT = 2;
const projects = (await getProjectEntries()).slice(0, RECENT_COUNT);
---

<section aria-labelledby="sec-projets" class="home-sec">
	<div class="wrap split">
		<div class="split__intro">
			<p class="kicker kicker--instrument mb-4">Projets</p>
			<h2 id="sec-projets" class="section-title mb-4">Réalisations</h2>
			<p class="m-0 mb-7 text-base leading-relaxed text-muted">
				Les outils, applications et ressources que je conçois, publiés ou en cours de construction.
			</p>
			<a href="/projets/" class="inline-flex items-center min-h-11 text-[15px] font-medium" data-astro-prefetch>Tous les projets →</a>
		</div>
		<div class="flex flex-col gap-6">
			{projects.length === 0 ? (
				<p class="m-0 py-8 border-t border-line-strong text-muted">Des projets sont en cours — revenez bientôt.</p>
			) : (
				projects.map((project) => <ProjectCard project={project} headingLevel="h3" />)
			)}
		</div>
	</div>
</section>

<style>
	.home-sec {
		padding: 104px 0 120px;
	}

	@media (max-width: 860px) {
		.home-sec {
			padding: 72px 0 96px;
		}
	}
</style>
