---
import Arc from './Arc.astro';
import Icon from './Icon.astro';

const axes = [
	{ title: 'Génie logiciel', text: 'Architecture, décisions de conception, qualité et outillage.' },
	{ title: 'Ingénierie de la résilience', text: 'Systèmes complexes, incidents, sûreté de fonctionnement.' },
	{ title: 'Ergonomie et sciences cognitives', text: 'Charge cognitive, prise de décision, interaction humain–agent.' },
];
---

<section class="hero">
	<Arc variant="home" />
	<div class="wrap hero__grid">
		<div>
			<p class="kicker mb-7">Blog technique · Mathurin Bourgouin</p>
			<h1 class="hero__title">
				Génie logiciel, résilience et <em>ergonomie cognitive</em>.
			</h1>
			<p class="lead mb-10 max-w-[34em]">
				Analyses, retours d'expérience et notes de lecture sur la conception de systèmes logiciels fiables — et sur ce
				que les agents IA changent pour leur exploitation, leur test et leur gouvernance.
			</p>
			<div class="flex flex-wrap gap-3">
				<a href="/blog/" class="btn btn--primary" data-astro-prefetch>Lire les articles<Icon name="arrow-right" size={16} /></a>
				<a href="/rss.xml" class="btn btn--ghost">S'abonner par RSS</a>
			</div>
		</div>
		<div>
			<p class="kicker mb-2 text-muted">Axes éditoriaux</p>
			<ol class="list-none m-0 p-0">
				{axes.map((axe, i) => (
					<li class="flex gap-5 py-[22px] border-b border-line">
						<span class="font-mono text-[13px] text-signal pt-[3px]">{String(i + 1).padStart(2, '0')}</span>
						<div>
							<p class="m-0 mb-1.5 font-semibold">{axe.title}</p>
							<p class="m-0 text-sm leading-relaxed text-muted">{axe.text}</p>
						</div>
					</li>
				))}
			</ol>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		padding: 104px 0 150px;
		border-bottom: 1px solid var(--color-line-strong);
	}

	.hero__grid {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: 72px;
		align-items: start;
	}

	.hero__title {
		margin: 0 0 28px;
		font-size: 3.25rem;
		line-height: 1.1;
		font-weight: 600;
		letter-spacing: -0.025em;
		color: var(--color-paper);
	}

	.hero__title em {
		font-style: italic;
		font-weight: 500;
		color: var(--color-signal-light);
	}

	@media (max-width: 860px) {
		.hero {
			padding: 72px 0 140px;
		}

		.hero__grid {
			grid-template-columns: 1fr;
			gap: 48px;
		}

		.hero__title {
			font-size: 2.25rem;
		}
	}
</style>
