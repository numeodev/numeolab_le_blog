---
import Icon from './Icon.astro';

interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;

const shareText = encodeURIComponent(`${title} — ${url}`);
const bskyUrl = `https://bsky.app/intent/compose?text=${shareText}`;
const mastodonUrl = `https://mastodon.social/share?text=${shareText}`;
---

<div class="flex flex-wrap items-center justify-between gap-6">
  <div>
    <p class="m-0 mb-3.5 text-[15px] font-medium">Des réactions sur cet article ?</p>
    <div class="flex flex-wrap gap-2.5">
      <a href={bskyUrl} target="_blank" rel="noopener noreferrer" class="share-link">
        <Icon name="bluesky" size={16} />Bluesky
      </a>
      <a href={mastodonUrl} target="_blank" rel="noopener noreferrer" class="share-link">
        <Icon name="mastodon" size={16} />Mastodon
      </a>
    </div>
  </div>
  <a href="https://ko-fi.com/numeolab" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 min-h-11 text-sm font-medium">
    <Icon name="kofi" size={16} />Soutenir Numeolab sur Ko-fi
  </a>
</div>

<style>
  .share-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--color-line-strong);
    border-radius: 6px;
    color: var(--color-text);
    font-size: 14px;
    font-weight: 500;
  }

  .share-link:hover {
    border-color: var(--color-signal);
    color: #fff;
  }
</style>
