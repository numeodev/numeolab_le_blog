---
import type { ProjectEntry } from '../lib/entries';
import FormattedDate from './FormattedDate.astro';
import Icon from './Icon.astro';

interface Props {
	project: ProjectEntry;
	headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel: Heading = 'h2' } = Astro.props;
---

<article class="project-card">
	<p class="meta m-0">
		<span class="text-instrument">{project.number}</span> · <FormattedDate date={project.publishedAt} format="month-year" />
	</p>
	<Heading class="project-card__title">{project.title}</Heading>
	<p class="m-0 text-[15px] leading-relaxed text-muted">{project.description}</p>
	{project.stack.length > 0 && (
		<div class="flex flex-wrap gap-2">
			{project.stack.map((tech) => <span class="tag">{tech}</span>)}
		</div>
	)}
	{(project.projectUrl || project.projectRepo) && (
		<div class="project-card__links">
			{project.projectUrl && (
				<a href={project.projectUrl} target="_blank" rel="noopener noreferrer">
					Voir le projet<Icon name="arrow-up-right" size={14} />
				</a>
			)}
			{project.projectRepo && (
				<a href={project.projectRepo} target="_blank" rel="noopener noreferrer" class:list={{ 'text-muted': !!project.projectUrl }}>
					<Icon name="github" size={16} />Code source
				</a>
			)}
		</div>
	)}
</article>

<style>
	.project-card {
		height: 100%;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: 18px;
		padding: 32px;
		border: 1px solid var(--color-line-strong);
		border-top: 2px solid var(--color-instrument);
		border-radius: 8px;
		background: var(--color-surface);
	}

	.project-card__title {
		margin: 0;
		font-size: 22px;
		line-height: 1.3;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--color-paper);
	}

	.project-card__links {
		display: flex;
		flex-wrap: wrap;
		gap: 24px;
		margin-top: auto;
		padding-top: 18px;
		border-top: 1px solid var(--color-line);
	}

	.project-card__links a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		font-size: 15px;
		font-weight: 500;
	}
</style>
