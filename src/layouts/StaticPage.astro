---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';

interface Props {
  title: string;
  description: string;
  kicker: string;
  heading: string;
  intro?: string;
  updated?: string;
}

const { title, description, kicker, heading, intro, updated } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header />
    <main>
      <PageHeader kicker={kicker} title={heading} intro={intro} />
      <div class="read py-[72px] pb-24">
        <div class="prose prose--ui">
          <slot />
        </div>
        {updated && <p class="meta m-0 mt-14">Dernière mise à jour : {updated}</p>}
      </div>
    </main>
    <Footer />
  </body>
</html>
