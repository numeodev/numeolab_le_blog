---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import Pagination from '../components/Pagination.astro';
import ProjectCard from '../components/ProjectCard.astro';
import type { ProjectEntry } from '../lib/entries';

interface Props {
	pageTitle: string;
	total: number;
	projects: ProjectEntry[];
	currentPage: number;
	totalPages: number;
}

const { pageTitle, total, projects, currentPage, totalPages } = Astro.props;
const intro = 'Les outils, applications et ressources que je conçois, publiés ou en cours de construction.';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={pageTitle} description={intro} />
	</head>
	<body>
		<Header />
		<main>
			<PageHeader
				kicker={`Projets · ${total} réalisation${total > 1 ? 's' : ''}`}
				title="Réalisations"
				intro={intro}
				accent="instrument"
			/>

			<section aria-label="Liste des projets" class="py-[72px] pb-28">
				<div class="wrap">
					{projects.length === 0 ? (
						<p class="m-0 text-muted">Des projets sont en cours — revenez bientôt pour voir ce qui se construit.</p>
					) : (
						<ul class="project-grid">
							{projects.map((project) => (
								<li>
									<ProjectCard project={project} />
								</li>
							))}
						</ul>
					)}

					{totalPages > 1 && <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl="/projets" />}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.project-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	@media (max-width: 860px) {
		.project-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
