---
import BaseHead from '../components/BaseHead.astro';
import EntryRow from '../components/EntryRow.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import Pagination from '../components/Pagination.astro';
import ThemeFilter from '../components/ThemeFilter.astro';
import { groupByYear, type ArticleEntry, type Theme } from '../lib/entries';

interface Props {
	pageTitle: string;
	description: string;
	kicker: string;
	heading: string;
	intro: string;
	articles: ArticleEntry[];
	themes: Theme[];
	currentTheme?: string;
	pagination?: { currentPage: number; totalPages: number };
}

const { pageTitle, description, kicker, heading, intro, articles, themes, currentTheme, pagination } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={pageTitle} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<PageHeader kicker={kicker} title={heading} intro={intro} flush>
				<ThemeFilter themes={themes} current={currentTheme} />
			</PageHeader>

			<section aria-label="Liste des articles" class="py-[72px] pb-24">
				<div class="wrap">
					{articles.length === 0 ? (
						<p class="m-0 text-muted">Les premiers articles sont en cours de rédaction — revenez bientôt.</p>
					) : (
						<div class="flex flex-col gap-12">
							{groupByYear(articles).map(([year, items]) => (
								<div class="year">
									<h2 class="year__label">{year}</h2>
									<ul class="list-none m-0 p-0">
										{items.map((article) => <EntryRow article={article} dateFormat="day-month" showTags />)}
									</ul>
								</div>
							))}
						</div>
					)}

					{pagination && pagination.totalPages > 1 && (
						<Pagination currentPage={pagination.currentPage} totalPages={pagination.totalPages} baseUrl="/blog" />
					)}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.year {
		display: grid;
		grid-template-columns: 160px minmax(0, 1fr);
		gap: 48px;
		align-items: start;
	}

	.year__label {
		margin: 0;
		padding-top: 30px;
		font-family: var(--font-mono);
		font-size: 15px;
		font-weight: 500;
		color: var(--color-text);
	}

	@media (max-width: 860px) {
		.year {
			grid-template-columns: 1fr;
			gap: 0;
		}

		.year__label {
			padding-top: 0;
		}
	}
</style>
